# ✅ Stage 1 — Build React app using Node 22
FROM node:22-alpine AS build
WORKDIR /app

# Install git (for clone) and build tools
RUN apk add --no-cache git

# Clone latest code from GitHub
RUN git clone --branch main https://github.com/vk-vaishnavi10/wanderly ./

# Install dependencies and build React
RUN npm install
RUN npm run build

# ✅ Stage 2 — Serve with Nginx
FROM nginx:1.25-alpine

# Copy React build output (adjust folder if using CRA -> /app/build)
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx.conf
COPY travel/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK CMD wget --spider -q http://localhost:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
